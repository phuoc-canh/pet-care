{
  // account_id và API token KHÔNG nằm ở đây: wrangler đọc CLOUDFLARE_ACCOUNT_ID /
  // CLOUDFLARE_API_TOKEN từ worker/.env. REVID_API_KEY và APP_TOKEN là secret
  // (local: .dev.vars, production: `wrangler secret put`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "petpal-ai-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Custom domain; vẫn giữ *.workers.dev làm link dự phòng.
  "routes": [{ "pattern": "api.ezio.id.vn", "custom_domain": true }],
  "workers_dev": true,
  "vars": {
    // google/gemini-flash thuộc nhóm miễn phí (chỉ 10 lượt) -> dùng model trả phí theo credit.
    // deepseek-v4.1-flash: ~4s, tiếng Việt tốt, tuân thủ system prompt. Dự phòng: grok-4.7 (khác nhà cung cấp).
    "AI_MODEL": "deepseek-v4.1-flash",
    "AI_FALLBACK_MODEL": "grok-4.7"
  }
}
