{
  // account_id và API token KHÔNG nằm ở đây: wrangler đọc CLOUDFLARE_ACCOUNT_ID /
  // CLOUDFLARE_API_TOKEN từ worker/.env. REVID_API_KEY và APP_TOKEN là secret
  // (local: .dev.vars, production: `wrangler secret put`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "petpal-ai-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Custom domain; vẫn giữ *.workers.dev làm link dự phòng.
  "routes": [{ "pattern": "api.ezio.id.vn", "custom_domain": true }],
  "workers_dev": true,
  "vars": {
    // Chuỗi model TRẢ PHÍ theo thứ tự ưu tiên (đã đo thực tế). Lỗi riêng của model
    // (404/5xx/timeout) → worker tự chuyển model kế tiếp. Đổi thứ tự/model không cần sửa code.
    // Không dùng model free tier (vd. google/gemini-flash chỉ 10 lượt rồi trả 402).
    "AI_MODELS": "deepseek-v4.1-flash,gpt-5.6-luna,grok-4.7"
  }
}
